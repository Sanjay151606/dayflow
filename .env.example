# ==================================================
# DAYFLOW - Environment Configuration Template
# ==================================================

# 1. Supabase Project Credentials
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_PUBLISHABLE_KEY=your-supabase-publishable-anon-key
SUPABASE_SECRET_KEY=your-supabase-service-role-secret-key

# 2. Database Connection
# Supabase PostgreSQL connection string (Direct or Connection Pooler):
DATABASE_URL=postgresql://postgres.your-project-ref:your-db-password@aws-0-us-east-1.pooler.supabase.com:6543/postgres

# 3. Security & JWT
JWT_SECRET=dayflow_super_secure_jwt_secret_key_change_in_production_2026!
JWT_REFRESH_SECRET=dayflow_super_secure_refresh_secret_key_change_in_production_2026!
ACCESS_TOKEN_EXPIRE_MINUTES=60
REFRESH_TOKEN_EXPIRE_DAYS=7

# 4. CORS Origins
CORS_ORIGINS=["http://localhost:5173","http://localhost:3000","http://127.0.0.1:5173","http://localhost:8000"]

# 5. Storage Buckets (Supabase Storage)
SUPABASE_BUCKET_PROFILES=profile-pictures
SUPABASE_BUCKET_DOCS=employee-documents
SUPABASE_BUCKET_PAYROLL=salary-slips
MAX_UPLOAD_SIZE_MB=10
UPLOAD_DIR=./uploads
