DATABASE_URL=sqlite:///./dayflow.db
# For PostgreSQL in production/Docker:
# DATABASE_URL=postgresql://dayflow:dayflow_secret@localhost:5432/dayflow_db

SECRET_KEY=dayflow_super_secure_jwt_secret_key_change_in_production_2026!
REFRESH_TOKEN_SECRET=dayflow_super_secure_refresh_secret_key_change_in_production_2026!
ACCESS_TOKEN_EXPIRE_MINUTES=60
REFRESH_TOKEN_EXPIRE_DAYS=7

CORS_ORIGINS=["http://localhost:5173","http://localhost:3000","http://127.0.0.1:5173"]

UPLOAD_DIR=./uploads
MAX_UPLOAD_SIZE_MB=10

SMTP_HOST=smtp.mailtrap.io
SMTP_PORT=2525
SMTP_USERNAME=null
SMTP_PASSWORD=null
